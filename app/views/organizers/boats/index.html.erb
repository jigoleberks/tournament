<%# app/views/organizers/boats/index.html.erb %>
<h1 class="text-2xl font-semibold mt-4 mb-4">Boats</h1>

<% if @boats.any? %>
  <ul class="space-y-2">
    <% @boats.each do |boat| %>
      <li class="bg-slate-800 rounded-lg p-3">
        <div class="font-semibold text-slate-100"><%= boat.label %></div>
        <%= form_with url: organizers_boat_path(boat), method: :patch, local: true, class: "mt-2 space-y-2" do %>
          <%= text_field_tag "boat[name]", boat.name,
                             class: "w-full h-10 px-2 rounded bg-slate-900 border border-slate-700 text-slate-100 text-sm" %>
          <%= select_tag "boat[captain_user_id]",
                         boat_captain_options(current_club, boat),
                         class: "w-full h-10 px-2 rounded bg-slate-900 border border-slate-700 text-slate-100 text-sm" %>
          <div class="flex gap-2">
            <%= submit_tag "Save", class: "h-10 px-3 rounded bg-blue-600 active:bg-blue-700 text-white text-sm" %>
          </div>
        <% end %>
        <%= button_to "Retire", organizers_boat_path(boat), method: :delete,
                      data: { turbo_confirm: "Retire #{boat.name}? Past results keep it; it just stops showing in the picker." },
                      class: "mt-2 h-10 px-3 rounded bg-slate-700 active:bg-slate-600 text-slate-100 text-sm" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-slate-400 italic">No boats yet. Add one from a team tournament's entry list.</p>
<% end %>

<% if @retired_boats.any? %>
  <h2 class="text-lg font-semibold mt-8 mb-2 text-slate-400">Retired</h2>
  <ul class="space-y-2">
    <% @retired_boats.each do |boat| %>
      <li class="bg-slate-800/50 rounded-lg p-3 flex items-center justify-between gap-3">
        <div class="text-slate-400"><%= boat.label %></div>
        <div class="flex items-center gap-2">
          <%= button_to "Restore", restore_organizers_boat_path(boat), method: :post,
                        class: "h-10 px-3 rounded bg-slate-700 active:bg-slate-600 text-slate-100 text-sm" %>
          <%= button_to "Delete", purge_organizers_boat_path(boat), method: :delete,
                        data: { turbo_confirm: boat_delete_confirm(boat, @retired_entry_counts[boat.id]) },
                        class: "h-10 px-3 rounded bg-red-800 active:bg-red-700 text-red-50 text-sm" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
