<h1 class="text-2xl font-semibold mt-4 mb-1">Schedule league night</h1>
<p class="text-sm text-slate-400 mb-4">
  Creates <%= @occurrence.main_template.name %> and <%= @occurrence.side_template.name %>,
  already linked.
</p>

<% if @error.present? %>
  <div class="bg-red-900/30 border border-red-700 rounded-lg p-3 mb-4 text-sm text-red-200">
    <%= @error %>
  </div>
<% end %>

<% if @occurrence.starts_at.nil? %>
  <%# No default weekday/times means there is no next occurrence to prefill, so
      there is nothing to schedule yet. %>
  <div class="bg-slate-800 rounded-lg p-4 text-slate-300 space-y-3">
    <p>
      These templates need a weekday, a start time and an end time before a league
      night can be scheduled. Set them on
      <strong><%= @occurrence.main_template.name %></strong>, then come back.
    </p>
    <%= link_to "Edit #{@occurrence.main_template.name}",
                edit_organizers_tournament_template_path(@occurrence.main_template),
                class: "inline-flex items-center justify-center h-12 px-4 rounded-lg bg-blue-600 active:bg-blue-700 text-white font-semibold" %>
  </div>
<% elsif @occurrence.fully_scheduled? %>
  <p class="bg-slate-800 rounded-lg p-3 text-slate-300">That week is already scheduled.</p>
<% else %>
  <%= form_with url: organizers_tournament_template_league_night_path(tournament_template_id: @occurrence.main_template.id),
                local: true, class: "space-y-4",
                data: { controller: "league-night" } do %>
    <div class="bg-slate-800 rounded-xl p-4 space-y-3">
      <div>
        <%= label_tag "league_night[starts_at]", "Starts", class: "block text-sm text-slate-300 mb-1" %>
        <%= datetime_local_field_tag "league_night[starts_at]", @occurrence.starts_at.strftime("%Y-%m-%dT%H:%M"),
                                     class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700" %>
      </div>
      <div>
        <%= label_tag "league_night[ends_at]", "Ends", class: "block text-sm text-slate-300 mb-1" %>
        <%= datetime_local_field_tag "league_night[ends_at]", @occurrence.ends_at.strftime("%Y-%m-%dT%H:%M"),
                                     class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700" %>
      </div>
    </div>

    <% [[:main, @occurrence.main_template], [:side, @occurrence.side_template]].each do |column, template| %>
      <div class="bg-slate-800 rounded-xl p-4 space-y-3">
        <h2 class="text-lg font-semibold"><%= template.name %></h2>

        <%= label_tag "league_night[#{column}][format]", "Format", class: "block text-sm text-slate-300" %>
        <%= select_tag "league_night[#{column}][format]",
                       options_for_select(@formats.map { |key| [format_label(key), key] }, template.format),
                       class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700",
                       data: { league_night_target: "#{column}Format", action: "change->league-night#sync" } %>

        <%= label_tag "league_night[#{column}][species_id]", "Species", class: "block text-sm text-slate-300" %>
        <%= select_tag "league_night[#{column}][species_id]",
                       options_from_collection_for_select(Species.order(:name), :id, :name),
                       class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700",
                       data: { league_night_target: "#{column}Species", action: "change->league-night#sync" } %>

        <div data-league-night-target="<%= column %>CountRow">
          <%= label_tag "league_night[#{column}][slot_count]", "How many count", class: "block text-sm text-slate-300" %>
          <%= number_field_tag "league_night[#{column}][slot_count]", 1, min: 1,
                               class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700" %>
        </div>

        <div class="hidden grid grid-cols-2 gap-2" data-league-night-target="<%= column %>RangeRow">
          <div>
            <%= label_tag "league_night[#{column}][target_min_inches]", "Target min", class: "block text-sm text-slate-300" %>
            <%= number_field_tag "league_night[#{column}][target_min_inches]", 70, step: "0.25",
                                 class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700" %>
          </div>
          <div>
            <%= label_tag "league_night[#{column}][target_max_inches]", "Target max", class: "block text-sm text-slate-300" %>
            <%= number_field_tag "league_night[#{column}][target_max_inches]", 100, step: "0.25",
                                 class: "w-full h-12 px-3 rounded-lg bg-slate-900 border border-slate-700" %>
          </div>
        </div>

        <% if column == :side %>
          <label class="flex items-center gap-2 pt-1">
            <%= check_box_tag "league_night[side][blind_leaderboard]", "1", false,
                              class: "h-5 w-5", data: { league_night_target: "sideBlind", action: "change->league-night#sync" } %>
            <span class="text-slate-200">Blind leaderboard</span>
          </label>
          <p class="hidden bg-amber-900/30 border border-amber-700 rounded-lg p-3 text-sm text-amber-200"
             data-league-night-target="leakWarning"></p>
        <% end %>
      </div>
    <% end %>

    <%= submit_tag "Create both",
                   class: "w-full h-14 rounded-lg bg-blue-600 active:bg-blue-700 text-white text-lg font-semibold" %>
  <% end %>

  <p class="text-xs text-slate-500 mt-3">
    From the templates: season tag <%= @occurrence.main_template.season_tag %> ·
    season points on <%= @occurrence.main_template.awards_season_points ? @occurrence.main_template.name : @occurrence.side_template.name %> ·
    entrants-only · local · not judged · <%= @occurrence.main_template.name %> always blind.
  </p>
<% end %>
