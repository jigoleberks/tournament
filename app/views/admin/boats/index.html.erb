<div class="flex items-center justify-between mb-8">
  <h1 class="text-3xl font-bold">Boats</h1>
</div>

<div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden">
  <% if @boats.any? %>
    <ul class="divide-y divide-slate-700">
      <% @boats.each do |boat| %>
        <li class="p-4 hover:bg-slate-700/30 transition-colors flex flex-wrap items-center justify-between gap-3">
          <div class="text-slate-100 font-medium"><%= boat.label %></div>

          <div class="flex flex-wrap items-center gap-2">
            <%= form_with url: admin_boat_path(boat), method: :patch, local: true, class: "flex items-center gap-2" do %>
              <%= text_field_tag "boat[name]", boat.name,
                                 class: "h-9 px-2 rounded bg-slate-900 border border-slate-700 text-slate-100 text-sm w-40" %>
              <%= select_tag "boat[captain_user_id]",
                             options_from_collection_for_select(current_club.members.active.order(:name), :id, :name, boat.captain_user_id),
                             class: "h-9 px-2 rounded bg-slate-900 border border-slate-700 text-slate-100 text-sm" %>
              <%= submit_tag "Save",
                             class: "h-9 px-3 rounded bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition-colors" %>
            <% end %>
            <%= button_to "Retire", admin_boat_path(boat), method: :delete,
                          data: { turbo_confirm: "Retire #{boat.name}? Past results keep it; it just stops showing in the picker." },
                          class: "h-9 px-3 rounded bg-slate-700 hover:bg-slate-600 text-slate-100 text-sm font-medium transition-colors" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="p-12 text-center">
      <p class="text-slate-400 italic">No boats yet. Add one from a team tournament's entry list.</p>
    </div>
  <% end %>
</div>

<% if @retired_boats.any? %>
  <h2 class="text-xl font-bold mt-8 mb-4 text-slate-400">Retired</h2>
  <div class="bg-slate-800/50 rounded-xl border border-slate-700 overflow-hidden">
    <ul class="divide-y divide-slate-700">
      <% @retired_boats.each do |boat| %>
        <li class="p-4 flex flex-wrap items-center justify-between gap-3">
          <div class="text-slate-400"><%= boat.label %></div>
          <%= button_to "Restore", restore_admin_boat_path(boat), method: :post,
                        class: "h-9 px-3 rounded bg-slate-700 hover:bg-slate-600 text-slate-100 text-sm font-medium transition-colors" %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
